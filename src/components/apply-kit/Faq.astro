---
// Questions as an accordion (native <details>, works without JavaScript). The first one starts open.
interface Props {
  items: { q: string; a: string }[];
  eyebrow: string;
  title: string;
  /** "side": heading left, list right (desktop). "stack": heading above the list. */
  variant?: 'side' | 'stack';
}
import Icon from './Icon.astro';
const { items, eyebrow, title, variant = 'side' } = Astro.props;
---
<div class:list={['grid gap-8', variant === 'side' ? 'lg:grid-cols-[22rem_1fr] lg:gap-16' : '']}>
  <div>
    <p class="ak-eyebrow">{eyebrow}</p>
    <h2 class="ak-h2 mt-3">{title}</h2>
  </div>
  <div class="divide-y divide-line border-b border-line">
    {items.map((f, i) => (
      <details class="group py-5" open={i === 0}>
        <summary class="flex items-center justify-between gap-6 text-[17px] font-semibold leading-snug">
          {f.q}
          <span class="shrink-0 text-muted"><Icon name="plus" size={18} class="group-open:hidden" /><Icon name="minus" size={18} class="hidden group-open:block" /></span>
        </summary>
        <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-muted" set:html={f.a} />
      </details>
    ))}
  </div>
</div>
