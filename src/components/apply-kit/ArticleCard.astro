---
// An article as a card (cover with a tilted CV page) or as a compact row.
import { Image } from 'astro:assets';
import { formatDate, type Article } from '../../lib/apply-kit';
import { coverImage } from './images';
interface Props { a: Article; variant?: 'card' | 'row' | 'feature'; tint?: number }
const { a, variant = 'card', tint = 0 } = Astro.props;
const tints = ['bg-accent-soft', 'bg-[#FFF7ED]', 'bg-[#F0F9FF]', 'bg-[#F0FDF4]', 'bg-[#FDF4FF]', 'bg-[#FEFCE8]'];
const img = coverImage(a.cover);
const minLabel = a.lang === 'de' ? 'Min.' : 'min';
---
{variant === 'row' ? (
  <a href={a.url} class="group flex gap-4 border-t border-line py-4 first:border-t-0">
    <div class:list={['relative h-24 w-[84px] shrink-0 overflow-hidden rounded-[10px]', tints[tint % tints.length]]}>
      <div class="ak-page absolute left-2.5 top-3.5 w-16 rotate-3"><Image src={img} alt="" widths={[128]} sizes="64px" /></div>
    </div>
    <div class="min-w-0">
      <p class="text-xs text-muted">{a.category} · {a.minutes} {minLabel}</p>
      <p class="mt-1.5 text-base font-semibold leading-snug tracking-[-0.01em] group-hover:text-accent">{a.title}</p>
    </div>
  </a>
) : (
  <a href={a.url} class:list={['group flex flex-col overflow-hidden rounded-2xl border border-line transition-shadow hover:shadow-[0_18px_40px_-18px_rgb(30_27_75/0.3)]', variant === 'feature' && 'md:flex-row']}>
    <div class:list={['relative overflow-hidden', tints[tint % tints.length], variant === 'feature' ? 'h-56 md:h-auto md:w-1/2' : 'h-48 md:h-[200px]']}>
      <div class:list={['ak-page absolute left-1/2 rotate-3 transition-transform duration-300 group-hover:-translate-y-1', variant === 'feature' ? 'top-10 w-[190px] -translate-x-1/2 md:top-12 md:w-[230px]' : 'top-8 w-[150px] -translate-x-1/2']}>
        <Image src={img} alt="" widths={[300, 460]} sizes="230px" />
      </div>
    </div>
    <div class:list={['flex flex-1 flex-col gap-2.5 p-6', variant === 'feature' && 'md:justify-center md:p-10']}>
      <p class="flex items-center gap-2 text-xs text-muted"><span class="rounded-md bg-chip px-2 py-0.5 font-medium text-ink">{a.category}</span>{a.minutes} {minLabel} · {formatDate(a.date, a.lang)}</p>
      <p class:list={['font-semibold leading-[1.3] tracking-[-0.015em] group-hover:text-accent', variant === 'feature' ? 'text-[1.4rem] md:text-[1.75rem]' : 'text-[19px]']}>{a.title}</p>
      <p class="text-sm leading-relaxed text-muted">{a.description}</p>
      {a.draft && <p class="text-xs font-semibold text-warn">Draft · not published</p>}
    </div>
  </a>
)}
