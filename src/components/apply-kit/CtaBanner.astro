---
// The indigo closing banner.
import Icon from './Icon.astro';
interface Props { title: string; sub: string; label: string; href: string; icon?: string; event?: string }
const { title, sub, label, href, icon, event } = Astro.props;
---
<section class="mx-auto max-w-[76rem] px-5 pb-20 pt-6 md:px-8 md:pb-28">
  <div class="flex flex-col items-start justify-between gap-8 rounded-3xl bg-linear-135 from-accent to-accent-dark px-6 py-9 md:flex-row md:items-center md:px-16 md:py-14">
    <div class="max-w-2xl">
      <p class="text-[1.65rem] font-semibold leading-[1.15] tracking-[-0.03em] text-white md:text-4xl">{title}</p>
      <p class="mt-3 text-[15px] text-[#C7D2FE] md:text-base">{sub}</p>
    </div>
    <a href={href} class:list={['ak-btn ak-btn-light w-full md:w-auto', event && `plausible-event-name=${event}`]}>{icon && <Icon name={icon} size={17} />}{label}</a>
  </div>
</section>
