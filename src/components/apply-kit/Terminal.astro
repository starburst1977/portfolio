---
// A Claude Code session, drawn as a dark terminal window. Lines are plain text with a tone.
interface Line { t: string; tone?: 'cmd' | 'head' | 'ok' | 'warn' | 'dim' | 'text' }
interface Props { title?: string; lines: Line[]; class?: string; size?: 'sm' | 'md' }
const { title = 'apply-kit — Claude Code', lines, class: cls = '', size = 'md' } = Astro.props;
const tone = { cmd: 'text-white', head: 'text-[#A5B4FC]', ok: 'text-[#86EFAC]', warn: 'text-[#FCD34D]', dim: 'text-[#6B6B7B]', text: 'text-[#D4D4DC]' };
---
<div class:list={['overflow-hidden rounded-2xl bg-night shadow-[0_30px_70px_-20px_rgb(30_27_75/0.45)]', cls]} role="img" aria-label={lines.map((l) => l.t.trim()).join(' / ')}>
  <div class="flex items-center gap-2 border-b border-white/[0.08] px-4 py-3.5">
    <span class="h-[11px] w-[11px] rounded-full bg-[#FF5F57]"></span>
    <span class="h-[11px] w-[11px] rounded-full bg-[#FEBC2E]"></span>
    <span class="h-[11px] w-[11px] rounded-full bg-[#28C840]"></span>
    <span class="ml-2 truncate font-mono text-xs text-[#8B8B9A]">{title}</span>
  </div>
  <div class:list={['overflow-x-auto font-mono', size === 'sm' ? 'space-y-0.5 px-4 pb-4 pt-3.5 text-[12px] leading-[1.6]' : 'space-y-1 px-4 pb-5 pt-4 text-[12px] leading-[1.6] md:px-6 md:pb-6 md:pt-5 md:text-[14px]']}>
    {lines.map((l) => <p class:list={['whitespace-pre-wrap break-words md:whitespace-pre', tone[l.tone ?? 'text']]}>{l.t || ' '}</p>)}
  </div>
</div>
