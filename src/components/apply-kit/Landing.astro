<script>
  // Layout filter on the landing page: hides the layouts that don't match the chosen tab.
  document.querySelectorAll<HTMLElement>('[data-layout-filter]').forEach((bar) => {
    const list = bar.closest('section')!.querySelector<HTMLElement>('[data-layout-list]')!;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const f = btn.dataset.filter!;
      list.querySelectorAll<HTMLElement>('[data-tags]').forEach((li) => { li.hidden = f !== 'all' && !li.dataset.tags!.split(' ').includes(f); });
    });
  });
</script>
