---
// Standalone layout for the Apply Kit pages: own navigation, own footer, own styles.
// Head and analytics mirror Layout.astro so canonical URLs, hreflang and Plausible stay the same.
import '../styles/apply-kit.css';
import Icon from '../components/apply-kit/Icon.astro';
import { base, GITHUB, routes, ui, getArticles, type Lang } from '../lib/apply-kit';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Absolute or site-relative path to a social preview image (1200x675). */
  image?: string;
  /** The same page in the other language, for hreflang and the language switch. */
  altHref?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  active?: 'how' | 'pack' | 'ats' | 'articles';
  /** Structured data, one object or a list. */
  jsonLd?: object | object[];
}

const { title, description, lang = 'en', image, altHref, noindex = false, ogTitle, ogDescription, active, jsonLd } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'de' : 'en';

// Hardcoded to the www host on purpose: astro.config sets site to the apex domain, which does not resolve.
const SITE = 'https://www.svenread.com';
const canonical = new URL(Astro.url.pathname, SITE);
const ogImage = image ? new URL(image, canonical) : undefined;
const altAbs = altHref ? (() => { const u = new URL(altHref, canonical); if (!/\.[a-z0-9]+$/i.test(u.pathname) && !u.pathname.endsWith('/')) u.pathname += '/'; return u.href; })() : undefined;

const hasArticles = getArticles(lang).length > 0;
const nav = [
  { key: 'how', label: t.nav.how, href: `${routes.home[lang]}#how` },
  { key: 'pack', label: t.nav.pack, href: routes.pack[lang] },
  { key: 'ats', label: t.nav.ats, href: routes.ats[lang] },
  ...(hasArticles ? [{ key: 'articles', label: t.nav.articles, href: routes.articles[lang] }] : []),
];
const footCols = [
  { h: t.footCols.kit, items: [
    { label: t.nav.how, href: `${routes.home[lang]}#how` },
    { label: t.nav.pack, href: routes.pack[lang] },
    { label: 'GitHub', href: GITHUB },
  ] },
  { h: t.footCols.tools, items: [
    { label: t.nav.ats, href: routes.ats[lang] },
    ...(hasArticles ? [{ label: t.nav.articles, href: routes.articles[lang] }] : []),
  ] },
  { h: t.footCols.about, items: [
    { label: 'Sven Read', href: `${base}/about` },
    { label: t.contact, href: 'mailto:me@svenread.com' },
    { label: 'Impressum', href: `${base}/impressum` },
    { label: 'Datenschutz', href: `${base}/datenschutz` },
  ] },
];
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/apply-kit/favicon.svg`} />
    <link rel="preload" href={`${base}/apply-kit/fonts/geist-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    {altAbs && <link rel="alternate" hreflang={other} href={altAbs} />}
    {altAbs && <link rel="alternate" hreflang={lang} href={canonical.href} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apply Kit" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage.href} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="675" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    {ogImage && <meta name="twitter:image" content={ogImage.href} />}
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}

    <!-- Cookieless analytics (Plausible, EU-hosted), as on the rest of the site. Described in /datenschutz. -->
    <script is:inline async src="https://plausible.io/js/pa-ow4h9xTWPiHUyFcG6KXkR.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="bg-white text-ink">
    <header class="sticky top-0 z-40 border-b border-line bg-white/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-[76rem] items-center justify-between gap-6 px-5 py-3.5 md:px-8 lg:py-4">
        <a href={routes.home[lang]} class="flex items-center gap-2.5" aria-label="Apply Kit">
          <span class="grid h-[30px] w-[30px] place-items-center rounded-lg bg-accent text-white"><Icon name="file-text" size={17} /></span>
          <span class="text-[19px] font-semibold tracking-[-0.02em]">Apply Kit</span>
        </a>
        <nav class="hidden items-center gap-9 text-[15px] lg:flex" aria-label="Apply Kit">
          {nav.map((n) => (
            <a href={n.href} class:list={['transition-colors hover:text-ink', active === n.key ? 'font-semibold text-ink' : 'text-muted']} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-4 lg:gap-5">
          {altHref && <a href={altHref} hreflang={other} class="text-sm text-muted hover:text-ink" title={t.otherLangLabel}>{t.otherLang}</a>}
          <a href={GITHUB} class="ak-btn ak-btn-dark hidden !px-4 !py-2.5 !text-sm sm:inline-flex plausible-event-name=GitHub+Click"><Icon name="github" size={16} />{t.getFree}</a>
          <details class="group relative lg:hidden">
            <summary class="grid h-[38px] w-[38px] place-items-center rounded-[9px] border border-line" aria-label={t.menu}>
              <Icon name="menu" size={18} class="group-open:hidden" /><Icon name="x" size={18} class="hidden group-open:block" />
            </summary>
            <div class="absolute right-0 top-12 w-64 rounded-xl border border-line bg-white p-2 shadow-[0_18px_40px_-12px_rgb(30_27_75/0.25)]">
              {nav.map((n) => (
                <a href={n.href} class:list={['block rounded-lg px-3 py-2.5 text-[15px] hover:bg-chip', active === n.key ? 'font-semibold' : '']}>{n.label}</a>
              ))}
              <a href={GITHUB} class="ak-btn ak-btn-dark mt-2 w-full !text-sm plausible-event-name=GitHub+Click"><Icon name="github" size={16} />{t.getFreeLong}</a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line bg-card">
      <div class="mx-auto max-w-[76rem] px-5 pb-10 pt-12 md:px-8 md:pt-16">
        <div class="flex flex-col justify-between gap-10 md:flex-row">
          <div class="max-w-sm">
            <a href={routes.home[lang]} class="flex items-center gap-2.5">
              <span class="grid h-[30px] w-[30px] place-items-center rounded-lg bg-accent text-white"><Icon name="file-text" size={17} /></span>
              <span class="text-[19px] font-semibold tracking-[-0.02em]">Apply Kit</span>
            </a>
            <p class="mt-4 text-sm leading-relaxed text-muted">{t.footBlurb}</p>
          </div>
          <div class="grid grid-cols-3 gap-6 md:gap-16">
            {footCols.map((c) => (
              <div>
                <p class="text-[13px] font-semibold">{c.h}</p>
                <ul class="mt-3 space-y-2.5 text-sm text-muted">
                  {c.items.map((i) => <li><a href={i.href} class="hover:text-ink">{i.label}</a></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-10 flex flex-col justify-between gap-2 border-t border-line pt-6 text-[13px] text-muted sm:flex-row">
          <p>© {new Date().getFullYear()} Sven Read · {t.madeNear}</p>
          {altHref ? (
            <p>{lang === 'en' ? <span class="text-ink">English</span> : <a href={altHref} hreflang="en" class="hover:text-ink">English</a>} · {lang === 'de' ? <span class="text-ink">Deutsch</span> : <a href={altHref} hreflang="de" class="hover:text-ink">Deutsch</a>}</p>
          ) : <p>{lang === 'en' ? 'English' : 'Deutsch'}</p>}
        </div>
      </div>
    </footer>
  </body>
</html>
