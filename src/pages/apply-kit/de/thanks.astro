---
import Layout from '../../../layouts/Layout.astro';

// German version of /apply-kit/thanks. Polar's German checkout link redirects here after a
// completed purchase. Kept out of search results and out of the sitemap.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const steps = [
  { title: 'Node.js installieren', body: 'Von nodejs.org, die Version mit der Kennzeichnung LTS. Ist die Claude-App offen, beenden Sie sie danach einmal und starten sie neu.' },
  { title: 'Kit entpacken', body: 'Legen Sie den Ordner apply-kit dort ab, wo Sie ihn wiederfinden, zum Beispiel unter Dokumente.' },
  { title: 'In Claude Code öffnen', body: 'In der Claude-Desktop-App auf Code wechseln, einen Ordner öffnen und apply-kit auswählen. Fragt Claude, ob Sie dem Ordner vertrauen, bestätigen Sie.' },
  { title: '„Hallo“ tippen', body: 'Claude übernimmt ab da, beginnend mit einer Einrichtung von 15 Minuten, an deren Ende Ihr erster Lebenslauf als PDF steht.' },
];
---

<Layout
  lang="de"
  title="Danke: Apply Kit for Claude"
  description="Ihr Apply Kit ist unterwegs."
  noindex
  altLang={{ lang: 'en', href: `${base}/apply-kit/thanks` }}
>
  <article class="mx-auto max-w-3xl px-6 md:px-10 pt-32 md:pt-40 pb-32">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-6">Apply Kit for Claude</p>
    <h1 class="font-display text-5xl md:text-6xl leading-[1.05] tracking-tight">
      Danke. <strong>Ihr Apply Kit ist unterwegs.</strong>
    </h1>
    <p class="font-display text-2xl leading-snug mt-10">
      Polar, der Shop, der die Zahlung abwickelt, hat Ihnen eine E-Mail mit Beleg und Download geschickt. Ist sie in ein paar Minuten nicht da, schauen Sie bitte im Spam-Ordner nach.
    </p>

    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-10">So geht es los</h2>
      <ol class="space-y-8">
        {steps.map((s, i) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 items-baseline">
            <span class="font-fraunces text-4xl text-accent leading-none">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="font-display text-xl tracking-tight">{s.title}</p>
              <p class="font-sans text-base text-muted leading-relaxed mt-1">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="font-sans text-base text-muted leading-relaxed mt-10">
        Die README.md im Ordner beschreibt dieselben Schritte ausführlicher, mit einem deutschen Abschnitt.
      </p>
    </section>

    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-display text-2xl tracking-tight">Ein Tipp vorab</h2>
      <p class="font-sans text-base text-muted leading-relaxed mt-3">
        Wenn Sie Ihr LinkedIn-Profil nutzen: Klicken Sie vor dem Speichern als PDF auf jedes „…mehr“ und auf „Alle anzeigen“ unter Erfahrung. LinkedIn druckt nur, was auf dem Bildschirm aufgeklappt ist, alles andere kommt abgeschnitten an.
      </p>
    </section>

    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-display text-2xl tracking-tight">Hängen geblieben?</h2>
      <p class="font-sans text-base text-muted leading-relaxed mt-3">
        Schreiben Sie an <a href="mailto:me@svenread.com" class="text-ink underline decoration-hairline underline-offset-4 hover:decoration-accent">me@svenread.com</a> und sagen Sie mir, wo es nicht weiterging. Ein Screenshot hilft.
      </p>
    </section>
  </article>
</Layout>
