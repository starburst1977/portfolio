---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import cvEn from '../../assets/apply-kit/cv-en.png';
import letterEn from '../../assets/apply-kit/letter-en.png';
import cvDe from '../../assets/apply-kit/cv-de.png';
import letterDe from '../../assets/apply-kit/letter-de.png';
import portrait from '../../assets/portrait-about.jpeg';

// German version of /apply-kit. Same product, same numbers, German market wording.
const PRICE = '65 €';
// German checkout link: returns to /apply-kit/de/, succeeds to /apply-kit/de/thanks/.
const BUY_URL = 'https://buy.polar.sh/polar_cl_oy5ZBeS71ub3jzTs6Hfl86JcHbQhbn0Wo7OZn4QHc1s';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdf = (name: string) => `${base}/apply-kit/Lena_Hoffmann_${name}.pdf`;

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Apply Kit for Claude',
  description:
    'Einmal kaufen, lokal nutzen: Apply Kit macht Claude Code zum sorgfältigen Bewerbungsschreiber. Ehrliche Einschätzung jeder Stellenanzeige, maßgeschneiderter Lebenslauf und Anschreiben auf Deutsch oder Englisch, als druckfertige PDFs auf dem eigenen Rechner.',
  image: 'https://www.svenread.com/apply-kit/og.png',
  url: 'https://www.svenread.com/apply-kit/de/',
  brand: { '@type': 'Brand', name: 'Sven Read' },
  offers: [
    {
      '@type': 'Offer',
      price: '65',
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url: BUY_URL,
      seller: { '@type': 'Person', name: 'Sven Read' },
    },
  ],
};

// Svens eigene Suche, gezählt aus seinem Bewerbungstracker (Februar bis Juni 2026).
const proof = [
  { n: '89', label: 'Bewerbungen' },
  { n: '65', label: 'maßgeschneiderte Lebensläufe' },
  { n: '24', label: 'Anschreiben' },
  { n: '42', label: 'Absagen' },
  { n: '7', label: 'Einladungen zum Gespräch', accent: true },
];

const steps = [
  {
    title: 'Einmal einrichten, in 15 Minuten',
    body: 'Claude liest Ihren alten Lebenslauf und Ihr LinkedIn-Profil, legt Ihren Werdegang als eine Zeitleiste an und fragt alles nach, was zwischen den Quellen nicht zusammenpasst. Dazu Ihre Ziele und Ihr Briefkopf. Am Ende steht Ihr erster Lebenslauf als PDF.',
  },
  {
    title: 'Stellenanzeige einfügen',
    body: 'Claude sagt Ihnen ehrlich, wie gut die Stelle passt: was übereinstimmt, was fehlt und ob die Rolle unter oder über Ihrem Ziel liegt. Auch dann, wenn die Antwort lautet: nicht Ihre Zeit wert.',
  },
  {
    title: 'PDFs bekommen',
    body: 'Lebenslauf und Anschreiben für genau diese Stelle, in der Sprache der Anzeige, ausschließlich aus Ihren bestätigten Fakten. Jede Zahl wird vor dem PDF gegen Ihr Profil geprüft.',
  },
];

const promises = [
  { title: 'Nichts erfunden', body: 'Jede Angabe stammt aus einem Profil, das Sie bestätigt haben. Jede Zahl wird dagegen geprüft, bevor ein PDF entsteht.' },
  { title: 'Ehrliche Einschätzung', body: 'Fähigkeiten und Rolle werden getrennt bewertet. So fällt auf, wenn eine Stelle zwar machbar ist, aber ein Rückschritt wäre.' },
  { title: 'Anschreiben auf einer Seite', body: 'Etwas zu lange Anschreiben werden automatisch auf eine Seite gebracht. Bei deutlich zu langen gibt es eine klare Warnung.' },
  { title: 'PDFs, die überall funktionieren', body: 'Echter, markierbarer Text, den Bewerbungssysteme lesen können, und dasselbe Ergebnis auf jedem Rechner und Drucker.' },
  { title: 'Deutsch und Englisch', body: 'Mit deutschen Konventionen: Anschreiben mit Empfänger, Ort, Datum und Betreff, passende Anrede und Grußformel, deutsche Anführungszeichen und Datumsformate.' },
];

const examples = [
  { img: cvDe, title: 'Lebenslauf', note: 'Deutsch, 2 Seiten', file: 'CV_Nordlicht' },
  { img: letterDe, title: 'Anschreiben', note: 'Deutsch, mit Empfänger, Datum und Betreff', file: 'Anschreiben_Nordlicht' },
  { img: cvEn, title: 'CV', note: 'Englisch, 2 Seiten', file: 'CV_Kestrel' },
  { img: letterEn, title: 'Cover letter', note: 'Englisch, beginnt mit den Worten der Anzeige', file: 'CoverLetter_Kestrel' },
];

const faq = [
  {
    q: 'Funktioniert das im normalen Claude-Chat?',
    a: 'Nein. Es braucht Claude Code, das in der Claude-Desktop-App enthalten ist, weil die PDFs auf Ihrem Rechner entstehen. Sie brauchen einen Claude-Tarif, der Claude Code enthält.',
  },
  {
    q: 'Ist das ein Abo?',
    a: 'Nein. Sie zahlen einmal und behalten das Kit. Es läuft über Ihren eigenen Claude-Tarif.',
  },
  {
    q: 'Ich bin kein Designer. Ist das trotzdem etwas für mich?',
    a: 'Ja. Die Beispiele stammen von einer Produktmanagerin aus der Logistik. Es passt für jede Rolle, bei der Lebenslauf und Anschreiben zählen.',
  },
  {
    q: 'Merken Personaler, dass Claude geschrieben hat?',
    a: 'Es schreibt aus Ihren eigenen Fakten, in Ihrer Sprache, und Sie lesen und bestätigen alles, bevor es rausgeht. Es bleibt Ihre Bewerbung, Claude übernimmt den Entwurf.',
  },
  {
    q: 'Kann ich es für deutsche Bewerbungen nutzen?',
    a: 'Ja, in beide Richtungen. Die Sprache kommt aus der Stellenanzeige, und für das Anschreiben gelten die deutschen Konventionen.',
  },
  {
    q: 'Läuft es unter Windows?',
    a: 'Claude Code und Node.js laufen beide unter Windows, es sollte also funktionieren. Getestet ist es bisher unter macOS.',
  },
];
---

<Layout
  lang="de"
  title="Apply Kit for Claude: Lebenslauf und Anschreiben für jede Stelle, nichts erfunden"
  description="Stellenanzeige einfügen, maßgeschneiderten Lebenslauf und Anschreiben als druckfertige PDFs bekommen. Aus Ihren bestätigten Erfahrungen, auf Deutsch oder Englisch. Läuft in Claude Code."
  image="/apply-kit/og.png"
  altLang={{ lang: 'en', href: `${base}/apply-kit` }}
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <article>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pt-32 md:pt-40 lg:pt-44 pb-16 md:pb-20">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-6">Apply Kit for Claude</p>
      <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] leading-[1.02] tracking-tight max-w-5xl">
        Lebenslauf und Anschreiben für jede Stelle. <strong>Nichts erfunden.</strong>
      </h1>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-14 lg:gap-20 items-center mt-12 md:mt-16">
        <div>
          <p class="font-display text-2xl md:text-3xl text-ink leading-snug">
            Apply Kit macht Claude zum sorgfältigen Bewerbungsschreiber. Es lernt Ihren Werdegang einmal, prüft jede Stellenanzeige ehrlich und schreibt Lebenslauf und Anschreiben auf Deutsch oder Englisch, als druckfertige PDFs.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            {BUY_URL ? (
              <a href={BUY_URL} class="inline-flex items-center rounded-full bg-ink px-7 py-3.5 font-sans text-sm font-semibold tracking-wide text-cream transition-colors hover:bg-accent hover:text-cream plausible-event-name=Buy+Click">
                Apply Kit kaufen
              </a>
            ) : (
              <span class="inline-flex items-center rounded-full border border-hairline px-7 py-3.5 font-sans text-sm font-semibold tracking-wide text-muted">
                Demnächst
              </span>
            )}
            <a href="#beispiele" class="font-sans text-sm text-ink underline decoration-hairline underline-offset-4 hover:decoration-accent">Echte Beispiele ansehen</a>
          </div>
          <p class="font-sans text-sm text-muted mt-6">Läuft in Claude Code · Einmalkauf · {PRICE} inkl. MwSt.</p>
          <p class="font-sans text-sm text-muted mt-2"><a href={`${base}/apply-kit`} class="underline decoration-hairline underline-offset-4 hover:text-accent hover:decoration-accent" hreflang="en">Read this page in English</a></p>
        </div>

        <div class="fan" aria-hidden="true">
          <div class="sheet s1"><Image src={cvDe} alt="" widths={[360, 540]} sizes="(max-width: 1024px) 60vw, 330px" /></div>
          <div class="sheet s3"><Image src={letterEn} alt="" widths={[360, 540]} sizes="(max-width: 1024px) 60vw, 330px" /></div>
          <div class="sheet s2"><Image src={letterDe} alt="" widths={[360, 540]} sizes="(max-width: 1024px) 60vw, 330px" /></div>
        </div>
      </div>
    </section>

    <!-- Zahlen -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-muted mb-10">Aus einer echten Jobsuche, Februar bis Juni 2026</h2>
        <dl class="grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-10">
          {proof.map((p) => (
            <div>
              <dt class:list={['font-fraunces text-6xl md:text-7xl leading-none tracking-tight', p.accent ? 'text-accent' : 'text-ink']}>{p.n}</dt>
              <dd class="font-sans text-sm text-muted mt-3 leading-snug">{p.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Warum -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-muted mb-10">Warum es das gibt</h2>
        <div class="relative px-2 md:px-16 py-10 md:py-14">
          <span aria-hidden="true" class="font-fraunces text-accent text-[7rem] md:text-[10rem] leading-none absolute -top-6 -left-2 md:-top-8 md:-left-4 select-none">&bdquo;</span>
          <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-start">
            <p class="font-display text-2xl md:text-3xl leading-snug">Ich habe Apply Kit für meine eigene Jobsuche gebaut. Die Zahlen sind echt, gezählt aus meinem eigenen Bewerbungstracker, Absagen inklusive.</p>
            <p class="text-lg text-muted leading-relaxed md:pt-1.5">Irgendwann widersprachen sich meine Lebensläufe: ein Datum in der einen Version, ein anderes in der nächsten, ein Ergebnis mit 35 % hier und 40 % dort. Also habe ich den ganzen Prozess um eine Regel herum neu gebaut: Nichts kommt in eine Bewerbung, was ich nicht bestätigt habe. Beim ersten Lauf des fertigen Kits auf mich selbst fand es Fehler in meinem eigenen Lebenslauf.</p>
          </div>
          <span aria-hidden="true" class="font-fraunces text-accent text-[7rem] md:text-[10rem] leading-none absolute -bottom-16 right-0 md:-bottom-20 md:-right-2 select-none">&ldquo;</span>
        </div>
        <div class="flex items-center gap-4 mt-10 md:pl-16">
          <Image src={portrait} alt="Sven Read" widths={[112]} class="h-14 w-14 rounded-full object-cover" />
          <p class="font-sans text-sm text-muted"><a href={`${base}/`} class="text-ink hover:text-accent">Sven Read</a>, Produktdesigner bei München</p>
        </div>
      </div>
    </section>

    <!-- Ablauf -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-muted mb-12">So läuft es ab</h2>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-10">
          {steps.map((s, i) => (
            <li>
              <p class="font-fraunces text-6xl md:text-7xl text-accent leading-none tracking-tight">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="font-display text-2xl tracking-tight mt-6">{s.title}</h3>
              <p class="font-sans text-base text-muted leading-relaxed mt-3">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Belege -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-muted mb-6">So sieht eine Einschätzung aus</h2>
          <div class="rounded-2xl border border-hairline bg-white/60 p-6 md:p-8 font-sans text-[15px] leading-relaxed">
            <p><span class="font-semibold text-ink">Kestrel Logistics: Senior Product Manager, Carrier Platform.</span><br />Fähigkeiten: passt gut. Rolle: entspricht Ihrem Ziel.</p>
            <p class="mt-4 font-semibold text-ink">Passt</p>
            <ul class="mt-1 space-y-1 text-muted">
              <li>„Sie führen Nutzerinterviews selbst“ → wöchentliche Interviews mit Disponenten bei Frachtwerk</li>
              <li>„Sicher im Umgang mit SQL und Produktanalytik“ → SQL und Looker</li>
            </ul>
            <p class="mt-4 font-semibold text-ink">Aufpassen</p>
            <ul class="mt-1 space-y-1 text-muted">
              <li>Hybrid, zwei Bürotage pro Woche in München</li>
            </ul>
            <p class="mt-4 text-muted">Gefordert: Lebenslauf und Anschreiben.</p>
          </div>
        </div>
        <div>
          <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-muted mb-6">Was die Zahlenprüfung findet</h2>
          <div class="rounded-2xl bg-ink p-6 md:p-8 font-mono text-[13px] leading-relaxed text-cream/90">
            <p>✓ CV_Kestrel.md: alle 5 Zahlen im Profil bestätigt</p>
            <p class="mt-2">CoverLetter_Kestrel.md: 1 zu prüfen, 3 bestätigt</p>
            <p class="pl-4">⚠ "25%": nicht in Ihrem Profil …Reklamationen um 25 % gesenkt…</p>
          </div>
          <p class="font-sans text-base text-muted leading-relaxed mt-5">
            Vor jedem PDF wird jede Zahl gegen Ihr Profil geprüft, auch ausgeschriebene Zahlen und vage Angaben wie „Millionen von Nutzern“. Eine markierte Zahl fliegt raus, oder Sie bestätigen sie und sagen, woher sie stammt.
          </p>
        </div>
      </div>
    </section>

    <!-- Versprechen -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-12">Was es verspricht</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
          {promises.map((p) => (
            <div>
              <dt class="font-display text-xl md:text-2xl tracking-tight">{p.title}</dt>
              <dd class="font-sans text-base text-muted leading-relaxed mt-2">{p.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Beispiele -->
    <section id="beispiele" class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28 scroll-mt-24">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-muted mb-4">Echte Beispiele</h2>
        <p class="font-sans text-base text-muted leading-relaxed max-w-2xl mb-12">
          Mit dem Kit erstellt für Lena Hoffmann, eine erfundene Produktmanagerin aus der Logistik. Jede Zahl in ihren Unterlagen lässt sich auf ihr Profil zurückführen. Öffnen Sie die PDFs: Der Text ist echt und markierbar, genau so, wie ihn ein Personaler bekommt.
        </p>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
          {examples.map((e) => (
            <a href={pdf(e.file)} class="group block plausible-event-name=Example+PDF" target="_blank" rel="noopener">
              <div class="sheet transition-transform duration-300 group-hover:-translate-y-1">
                <Image src={e.img} alt={`${e.title}: ${e.note}`} widths={[300, 500]} sizes="(max-width: 1024px) 45vw, 260px" />
              </div>
              <p class="font-display text-lg mt-4 group-hover:text-accent transition-colors">{e.title}</p>
              <p class="font-sans text-sm text-muted">{e.note}</p>
              <p class="font-sans text-xs uppercase tracking-[0.15em] text-muted mt-2 group-hover:text-accent">PDF öffnen ↗</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Voraussetzungen + Daten -->
    <section class="mx-auto max-w-6xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16 grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-8">Was Sie brauchen</h2>
          <ul class="space-y-3 font-sans text-base leading-relaxed">
            <li class="pl-6 relative before:content-['—'] before:absolute before:left-0 before:text-accent">Die <a href="https://claude.ai/download" target="_blank" rel="noopener" class="underline decoration-hairline underline-offset-4 hover:decoration-accent">Claude-Desktop-App</a>, mit einem Claude-Tarif, der Claude Code enthält</li>
            <li class="pl-6 relative before:content-['—'] before:absolute before:left-0 before:text-accent"><a href="https://nodejs.org" target="_blank" rel="noopener" class="underline decoration-hairline underline-offset-4 hover:decoration-accent">Node.js</a>, kostenlos, in wenigen Minuten installiert. Die README im Kit führt Sie durch</li>
            <li class="pl-6 relative before:content-['—'] before:absolute before:left-0 before:text-accent">Ihren aktuellen Lebenslauf als PDF. Ein als PDF gespeichertes LinkedIn-Profil hilft zusätzlich</li>
          </ul>
        </div>
        <div>
          <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-8">Ihre Daten</h2>
          <p class="font-sans text-base leading-relaxed">
            Alles bleibt in einem Ordner auf Ihrem Rechner. Das Kit hat kein Konto, keinen Server und keinen Cloud-Speicher. Ihre Angaben gehen ausschließlich an Claude, während Ihres Gesprächs, über Ihren eigenen Claude-Tarif.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-6 md:px-10 pb-20 md:pb-28">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-10">Fragen</h2>
        <dl class="space-y-8">
          {faq.map((f) => (
            <div>
              <dt class="font-display text-xl tracking-tight">{f.q}</dt>
              <dd class="font-sans text-base text-muted leading-relaxed mt-2">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Abschluss -->
    <section class="mx-auto max-w-3xl px-6 md:px-10 pb-32">
      <div class="border-t border-hairline pt-12 md:pt-16">
        <p class="font-display text-3xl md:text-4xl leading-snug tracking-tight">
          Ihre nächste Bewerbung, geschrieben aus dem, was Sie wirklich gemacht haben.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
          {BUY_URL ? (
            <a href={BUY_URL} class="inline-flex items-center rounded-full bg-ink px-7 py-3.5 font-sans text-sm font-semibold tracking-wide text-cream transition-colors hover:bg-accent hover:text-cream plausible-event-name=Buy+Click">
              Apply Kit kaufen
            </a>
          ) : (
            <span class="inline-flex items-center rounded-full border border-hairline px-7 py-3.5 font-sans text-sm font-semibold tracking-wide text-muted">
              Demnächst
            </span>
          )}
          <p class="font-sans text-sm text-muted">Einmalkauf · {PRICE} inkl. MwSt.</p>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .sheet {
    background: #fff;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgb(31 27 22 / 0.08), 0 14px 34px -10px rgb(31 27 22 / 0.22);
    overflow: hidden;
  }
  .sheet :global(img) { display: block; width: 100%; height: auto; }

  .fan { position: relative; aspect-ratio: 1 / 1.08; max-width: 34rem; margin-inline: auto; width: 100%; }
  .fan .sheet { position: absolute; width: 62%; }
  .fan .s1 { left: 0; top: 7%; transform: rotate(-6deg); }
  .fan .s3 { right: 0; top: 9%; transform: rotate(6deg); }
  .fan .s2 { left: 19%; top: 0; z-index: 2; }
</style>
