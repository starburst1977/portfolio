---
import Layout from '../../layouts/Layout.astro';
// Polar redirects here after a completed purchase of Layout Pack 1, so a pageview here is a
// sale. Kept out of search results and out of the sitemap. No buy button on purpose.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const GITHUB = 'https://github.com/starburst1977/apply-kit';
const steps = [
  { title: 'Get Apply Kit 1.1.0', body: 'The pack runs inside the free kit, version 1.1.0 or newer. New to Apply Kit? Download it from GitHub and follow its README. Already using it? Download the new version and copy your profile and applications folders into it.' },
  { title: 'Put the zip into the kit folder', body: 'Move the zip from your Downloads into the apply-kit folder, as it is. No need to unzip it.' },
  { title: 'Tell Claude “install the layout pack”', body: 'In Claude Code, with the apply-kit folder open. Claude installs the eight layouts and lists them.' },
  { title: 'Pick a layout', body: 'Say which one you like, for example “use the Mono layout”. Claude renders one of your documents in it, so you see it with your own CV.' },
];
---
<Layout
  lang="en"
  title="Thank you: Layout Pack 1 for Apply Kit"
  description="Your Layout Pack is on its way."
  noindex
  altLang={{ lang: 'de', href: `${base}/apply-kit/de/thanks` }}
>
  <article class="mx-auto max-w-3xl px-6 md:px-10 pt-32 md:pt-40 pb-32">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-6">Apply Kit · Layout Pack 1</p>
    <h1 class="font-display text-5xl md:text-6xl leading-[1.05] tracking-tight">
      Thank you. <strong>Your eight layouts are on their way.</strong>
    </h1>
    <p class="font-display text-2xl leading-snug mt-10">
      Polar, the shop that handles the payment, has sent you an email with your receipt and the download. If it isn’t there in a few minutes, check your spam folder.
    </p>
    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-10">Getting started</h2>
      <ol class="space-y-8">
        {steps.map((s, i) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 items-baseline">
            <span class="font-fraunces text-4xl text-accent leading-none">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="font-display text-xl tracking-tight">{s.title}</p>
              <p class="font-sans text-base text-muted leading-relaxed mt-1">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="font-sans text-base text-muted leading-relaxed mt-10">
        The kit is at <a href={GITHUB} class="text-ink underline decoration-hairline underline-offset-4 hover:decoration-accent">github.com/starburst1977/apply-kit</a>. LAYOUT-PACK-1.md inside the zip describes every layout.
      </p>
    </section>
    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-display text-2xl tracking-tight">One tip before you start</h2>
      <p class="font-sans text-base text-muted leading-relaxed mt-3">
        Statement, Mono, Sidebar and Poster put your CV on one page, in two columns. With a long career, Claude cuts it down to the strongest points, or suggests Modern, Compact or Margin for that application. A photo is optional in those four; just ask Claude for it.
      </p>
    </section>
    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-display text-2xl tracking-tight">Stuck?</h2>
      <p class="font-sans text-base text-muted leading-relaxed mt-3">
        Write to <a href="mailto:me@svenread.com" class="text-ink underline decoration-hairline underline-offset-4 hover:decoration-accent">me@svenread.com</a> and tell me where it stopped. A screenshot helps.
      </p>
    </section>
  </article>
</Layout>
