---
import Layout from '../../layouts/Layout.astro';

// Polar redirects here after a completed purchase, so a pageview here is a sale.
// Kept out of search results and out of the sitemap. No buy button on purpose.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const steps = [
  { title: 'Install Node.js', body: 'From nodejs.org, the version marked LTS. If the Claude app is open, quit and reopen it afterwards.' },
  { title: 'Unzip the kit', body: 'Put the apply-kit folder somewhere you will find it again, for example in Documents.' },
  { title: 'Open it in Claude Code', body: 'In the Claude desktop app, switch to Code, open a folder and pick apply-kit. If Claude asks whether you trust the folder, say yes.' },
  { title: 'Type “hi”', body: 'Claude takes it from there, starting with a 15-minute setup that ends with your first CV as a PDF.' },
];
---

<Layout
  lang="en"
  title="Thank you: Apply Kit for Claude"
  description="Your Apply Kit is on its way."
  noindex
  altLang={{ lang: 'de', href: `${base}/apply-kit/de/thanks` }}
>
  <article class="mx-auto max-w-3xl px-6 md:px-10 pt-32 md:pt-40 pb-32">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent mb-6">Apply Kit for Claude</p>
    <h1 class="font-display text-5xl md:text-6xl leading-[1.05] tracking-tight">
      Thank you. <strong>Your Apply Kit is on its way.</strong>
    </h1>
    <p class="font-display text-2xl leading-snug mt-10">
      Polar, the shop that handles the payment, has sent you an email with your receipt and the download. If it isn’t there in a few minutes, check your spam folder.
    </p>

    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-fraunces italic [font-variation-settings:'WONK'_1] text-4xl md:text-5xl leading-tight tracking-tight text-accent mb-10">Getting started</h2>
      <ol class="space-y-8">
        {steps.map((s, i) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 items-baseline">
            <span class="font-fraunces text-4xl text-accent leading-none">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="font-display text-xl tracking-tight">{s.title}</p>
              <p class="font-sans text-base text-muted leading-relaxed mt-1">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="font-sans text-base text-muted leading-relaxed mt-10">
        The README.md inside the folder has the same steps in more detail.
      </p>
    </section>

    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-display text-2xl tracking-tight">One tip before you start</h2>
      <p class="font-sans text-base text-muted leading-relaxed mt-3">
        If you use your LinkedIn profile, click every “see more” and “Show all experiences” before you save it as PDF. LinkedIn only prints what is open on screen, so anything collapsed arrives cut off.
      </p>
    </section>

    <section class="border-t border-hairline mt-16 pt-12">
      <h2 class="font-display text-2xl tracking-tight">Stuck?</h2>
      <p class="font-sans text-base text-muted leading-relaxed mt-3">
        Write to <a href="mailto:me@svenread.com" class="text-ink underline decoration-hairline underline-offset-4 hover:decoration-accent">me@svenread.com</a> and tell me where it stopped. A screenshot helps.
      </p>
    </section>
  </article>
</Layout>
